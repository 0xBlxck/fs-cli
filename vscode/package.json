{
  "name": "fs-cli-vscode",
  "displayName": "FS-CLI — France Student AI",
  "description": "(Communautaire, non officiel) Panneau de chat FS-CLI dans VS Code : l'agent France Student AI lit et modifie ton projet, avec diffs, tâches et confirmations.",
  "version": "0.10.3",
  "publisher": "0xblxck",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/0xBlxck/fs-cli" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["AI", "Chat", "Other"],
  "keywords": ["france student", "agent", "chat", "ai", "fs-cli"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "fsCli", "title": "FS-CLI", "icon": "media/sidebar.png" }]
    },
    "views": {
      "fsCli": [{ "type": "webview", "id": "fsCli.chat", "name": "Chat" }]
    },
    "commands": [
      { "command": "fsCli.open", "title": "FS-CLI : ouvrir dans un onglet", "icon": "media/logo.png" },
      { "command": "fsCli.focus", "title": "FS-CLI : ouvrir le panneau latéral" },
      { "command": "fsCli.newChat", "title": "FS-CLI : nouvelle conversation" },
      { "command": "fsCli.askSelection", "title": "Demander à FS-CLI" },
      { "command": "fsCli.login", "title": "FS-CLI : se connecter (clé de session)" },
      { "command": "fsCli.acceptProposal", "title": "FS-CLI : accepter la modification proposée", "shortTitle": "Accepter", "icon": "$(check)" },
      { "command": "fsCli.rejectProposal", "title": "FS-CLI : refuser la modification proposée", "shortTitle": "Refuser", "icon": "$(close)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "fsCli.acceptProposal", "when": "resourceScheme == fs-cli-proposal", "group": "navigation@1" },
        { "command": "fsCli.rejectProposal", "when": "resourceScheme == fs-cli-proposal", "group": "navigation@2" },
        { "command": "fsCli.open", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "fsCli.acceptProposal", "when": "resourceScheme == fs-cli-proposal" },
        { "command": "fsCli.rejectProposal", "when": "resourceScheme == fs-cli-proposal" }
      ],
      "editor/context": [{ "command": "fsCli.askSelection", "when": "editorHasSelection", "group": "navigation@99" }]
    },
    "keybindings": [
      { "command": "fsCli.open", "key": "ctrl+alt+i", "mac": "cmd+alt+i" },
      { "command": "fsCli.askSelection", "key": "ctrl+alt+k", "mac": "cmd+alt+k", "when": "editorTextFocus" }
    ],
    "configuration": {
      "title": "FS-CLI",
      "properties": {
        "fsCli.command": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "Commande pour lancer FS-CLI (vide = automatique : installation globale « npm i -g », sinon « fs-cli » du PATH)."
        },
        "fsCli.shareSelection": {
          "type": "boolean",
          "default": true,
          "description": "Joindre au message le fichier ouvert et le code sélectionné (désactivable aussi d'un clic dans le panneau)."
        }
      }
    }
  }
}
