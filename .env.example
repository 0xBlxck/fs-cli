# Copie ce fichier en « .env » (il est ignoré par git) puis remplis la valeur.
# Ne partage JAMAIS ce fichier une fois rempli : le token est l'équivalent d'un mot de passe.

# Valeur du cookie « next-auth.session-token » de https://ia.francestudent.org
# (F12 → Application/Stockage → Cookies). À récupérer toi-même.
FS_SESSION_TOKEN=colle-ton-token-ici

# Facultatif : modèle par défaut (voir /models) et dossier de travail
# FS_AGENT_ID=-2003
# FS_WORKDIR=

# Facultatif : recherche web (/search). Sans clé : DuckDuckGo. "none" désactive.
# FS_SEARCH_API_KEY=
# FS_SEARCH_PROVIDER=
